<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <application android:label="题了个题 · 旧版练习" android:allowBackup="false" android:icon="@drawable/legacy_icon" android:banner="@drawable/legacy_banner" android:usesCleartextTraffic="true" android:theme="@android:style/Theme.Holo.Light.NoActionBar">
        <activity android:name=".LegacyActivity" android:exported="true" android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /><category android:name="android.intent.category.LEANBACK_LAUNCHER" /></intent-filter>
        </activity>
    </application>
</manifest>
